# ===== 模型 =====
# 在 https://platform.deepseek.com 创建，充值时把上限设为 200 元
DEEPSEEK_API_KEY=sk-xxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# ===== 视觉模型（拍照讲题）=====
# 阿里云百炼控制台创建 Key；2026 年可用的视觉模型名是 qwen3-vl-plus
# 如果控制台提示模型不存在，先在 /compatible-mode/v1/models 查可用列表
# 不填也能启动，只是上传图片会提示未配置
VISION_API_KEY=sk-xxxxxxxx
VISION_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen3-vl-plus

# ===== 联网检索（web_search）=====
# 在 https://app.tavily.com 注册后创建，免费额度足够 W3 验收
# 不填也能启动，只是模型调用 web_search 时会提示未配置
TAVILY_API_KEY=tvly-xxxxxxxx
TAVILY_BASE_URL=https://api.tavily.com
WEB_SEARCH_MAX_RESULTS=5

# ===== 应用 =====
APP_ENV=dev

# 默认数据库在 ai-agent/data/app.db，一般不用改
# DATABASE_URL=sqlite:///./data/app.db

# ===== 生成参数 =====
TEMPERATURE=0.7
MAX_TOKENS=800
HISTORY_LIMIT=16
